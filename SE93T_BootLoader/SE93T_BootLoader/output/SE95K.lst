8:				* 修改说明:
9:				*******************************************************************************/
10:				#include "defines.h"
11:				
12:				//----------------------------------------------------------------------------;
13:				//变量定义
14:				//
15:				extern void USBD_CalibrationInit(void);
16:				
17:				//----------------------------------------------------------------------------;
18:				//变量定义
19:				//
20:				unsigned char               bootloader_val[4] @ 0X0280;
21:				
22:				//-----------------------------------------------------------------------------;
23:				#define iPORT_A            0
24:				#define iPORT_B            1 
25:				#define iPORT_C            2
26:				#define iPORT_D            3
27:				#define iPORT_E            4
28:				
29:				#define iDIR_IN            0
30:				#define iDIR_OUT           1
31:				
32:				//-----------------------------------------------------------------------------;
33:				// 表格定义区
34:				//
35:				const unsigned int low_int[2] @0x0008 =
36:				{
37:				    0xDF04, 0xF008,                     // goto 0x1008
38:				};
39:				const unsigned int high_int[2] @0x0018 =
40:				{
41:				    0xDF0C, 0xF008,                     // goto 0x1018
42:				};
43:				
44:				const unsigned char boot_fw_vs[] @0x0FF0 =
45:				{
46:				    'B',  'o',  'o'-0x60,  't'-0x60,  '-', 'V'-0x60,  '2', '0',
47:				    iPROJECT_ID_0,
48:				    iPROJECT_ID_1,
49:				    iPROJECT_ID_2,
50:				    iPROJECT_ID_3,
51:				    iVERSION_ID,
52:					0xAA,
53:					0x55,
54:					0x5A,
55:				};
56:				
57:				const unsigned char boot_key_tbl[] @0x0FE8 =
58:				{												// ESC PB0 PE5
59:				    iPORT_B,									// port
60:				    (1<<0),										// pin
61:				    (1<<0),										// check
62:				    0xAA,										//
63:																// WIN PB1 PE0
64:				    iPORT_B,									// port
65:				    (1<<1),										// pin
66:				    (1<<0),										// check
67:				    0x55,										//
68:				};
69:				
70:				//=============================================================================;
71:				// 代码区                                                                      ;
72:				//=============================================================================;
73:				
74:				void port_set(unsigned char port, unsigned char pin, unsigned char dir)
75:				{
76:				    if(iPORT_B==port)
77:					{
78:					    ANSB &= ~pin;
79:					    if(iDIR_IN==dir)
80:					    {										// 输入
81:				            PUB |= pin;
82:				            OEB &= ~pin;
83:						}
84:					    else
85:					    {										// 输出低
86:				            OEB |= pin;
87:							IOB &= ~pin;
88:					    }
89:					}
90:					else if(iPORT_C==port)
91:					{
92:					    ANSC &= ~pin;
93:					    if(iDIR_IN==dir)
94:					    {										// 输入
95:				            PUC |= pin;
96:				            OEC &= ~pin;
97:						}
98:					    else
99:					    {										// 输出低
100:				            OEC |= pin;
101:							IOC &= ~pin;
102:					    }
103:					}
104:					else if(iPORT_D==port)
105:					{
106:					    ANSD &= ~pin;
107:					    if(iDIR_IN==dir)
108:					    {										// 输入
109:				            PUD |= pin;
110:				            OED &= ~pin;
111:						}
112:					    else
113:					    {										// 输出低
114:				            OED |= pin;
115:							IOD &= ~pin;
116:					    }
117:					}
