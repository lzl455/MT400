16:				
17:				//-----------------------------------------------------------------------------;
18:				// 变量定义区
19:				//
20:				USBD_U8                         uwheel_status_1;
21:				
22:				//=============================================================================;
23:				// 代码区                                                                      ;
24:				//=============================================================================;
25:				
26:				/*******************************************************************************
27:				* 函数名称: wheel_scan()
28:				* 功能描述: 滚轮扫描处理
29:				* 输入参数：无
30:				* 输出参数：无
31:				* 说    明:
32:				*******************************************************************************/
33:				void wheel_scan(void)
34:				{
35:				    bcurr_a_status_1 = WHEEL_A_1;
36:				    bcurr_b_status_1 = WHEEL_B_1;
37:				
38:				    if(bcurr_a_status_1 != bcurr_b_status_1)
39:				    {                                           //  设置不稳定状态有效位
40:				        bno_status_valid_1 = 1;
41:				        bpre_ab_no_status_1 = bcurr_a_status_1;
42:				        return;
43:				    }
44:				
45:				    if(bpre_ab_status_1 == bcurr_a_status_1)
46:				    {
47:				   	    return;                                 // 前后状态没有变化
48:				    }
49:				
50:				    if(bno_status_valid_1)
51:				    {
52:				        bno_status_valid_1 = 0;
53:				
54:				        if(bpre_ab_no_status_1)
55:				        {
56:				            bwheel_data_status_1 = bpre_ab_status_1;
57:				        }
58:				        else
59:				        {
60:				            bwheel_data_status_1 = !bpre_ab_status_1;
61:				        }
62:				        if(bwheel_data_status_1)
63:				        {
64:				            multi_key[0] = iMMK_VOLUMEDOWN_L;
65:				            multi_key[1] = iMMK_VOLUMEDOWN_H;
66:				        }
67:				        else
68:				        {
69:				            multi_key[0] = iMMK_VOLUMEUP_L;
70:				            multi_key[1] = iMMK_VOLUMEUP_H;
71:				        }
72:				        bmmk_data_send = 1;
73:				    }
74:				
75:				    bpre_ab_status_1 = bcurr_a_status_1;
76:				}
