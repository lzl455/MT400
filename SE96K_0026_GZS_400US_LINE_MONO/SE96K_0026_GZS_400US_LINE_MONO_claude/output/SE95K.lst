10:				#include "..\defines.h"
11:				
12:				//=============================================================================;
13:				// 配置引用区                                                                  ;
14:				//=============================================================================;
15:				
16:				enum RGB_MODE_Enum              wheel_led_cur_mode;
17:				enum RGB_MODE_Enum              wheel_led_pre_mode;
18:				
19:				unsigned char                   hclg_ctrl_tbl[4];
20:				unsigned char                   wheel_led_array[4];
21:				
22:				//-----------------------------------------------------------------------------;
23:				// 表格定义区
24:				//
25:				unsigned char       const   wheel_hclg_tbl[]={
26:				  128, 64,  0,  64,
27:				};
28:				
29:				unsigned char       const   wheel_hclg_ctrl_tbl[]={
30:				    0,  0,  1,  1,
31:				};
32:				
33:				//=============================================================================;
34:				// 代码区                                                                      ;
35:				//=============================================================================;
36:				
37:				void wheel_led_off(void)
38:				{
39:				    wheel_led_array[0] = 0;
40:				    wheel_led_array[1] = 0;
41:				    wheel_led_array[2] = 0;
42:				    wheel_led_array[3] = 0;
43:				}
44:				
45:				/*******************************************************************************
46:				* 函数名称: led_process()
47:				* 功能描述:
48:				* 输入参数： 无
49:				* 输出参数： 无
50:				* 说    明:
51:				*******************************************************************************/
52:				void wheel_led_process(void)
53:				{
54:				    unsigned char temp_i;
55:				
56:				    if(wheel_led_pre_mode != wheel_led_cur_mode)
57:				    {
58:				        wheel_led_pre_mode = wheel_led_cur_mode;
59:				
60:				        wheel_led_off();
61:				
62:				        switch(wheel_led_cur_mode)
63:				        {
64:				            case iMODE_WHEEL_OFF:
65:				                break;
66:				            case iMODE_WHEEL_HCLG:
67:				                for(temp_i=0; temp_i<iBACK_COUNT; temp_i++)
68:				                {
69:				                    wheel_led_array[temp_i] = wheel_hclg_tbl[temp_i];
70:				                    hclg_ctrl_tbl[temp_i] = wheel_hclg_ctrl_tbl[temp_i];
71:				                }
72:				                break;
73:				            case iMODE_WHEEL_BREATH:
74:				                break;
75:				            case iMODE_WHEEL_ON:
76:				                break;
77:				
78:				        }
79:				    }
80:				    else
81:				    {
82:				        if(0==led_light_lev)
83:					    {
84:				            wheel_led_off();
85:				            return;
86:					    }
87:				
88:					    if(iMODE_WHEEL_HCLG == wheel_led_cur_mode)
89:				        {
90:				            for(temp_i=0; temp_i<4; temp_i++)
91:				            {
92:				                if(0 == hclg_ctrl_tbl[temp_i])
93:				                {
94:				                    wheel_led_array[temp_i]--;
95:				                    if(0 == wheel_led_array[temp_i])
96:				                        hclg_ctrl_tbl[temp_i]++;
97:				                }
98:				                else
99:				                {
100:				                    wheel_led_array[temp_i]++;
101:				                    if(iPWM_MAX <= wheel_led_array[temp_i])
102:				                        hclg_ctrl_tbl[temp_i]=0;
103:				                }
104:				            }
105:						}
106:				        else if(iMODE_WHEEL_BREATH == wheel_led_cur_mode)
107:						{
108:				
109:						}
110:						else if(iMODE_WHEEL_ON == wheel_led_cur_mode)
111:						{
112:				             wheel_led_array[0] = iPWM_MAX;
113:				             wheel_led_array[1] = iPWM_MAX;
114:				             wheel_led_array[2] = iPWM_MAX;
115:				             wheel_led_array[3] = iPWM_MAX;
116:				
117:						}
118:				    }
119:				}
